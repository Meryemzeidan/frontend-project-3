<!DOCTYPE html>
<html>
  <head>
    <title>hu portal</title>
    <style>
      .head{
        border: 2px solid green;
        background-color:green;
        color:white;
        margin:0px;
        padding:10px;
        height: 60px;
      }
     .menu {
        position: absolute;
        right: 15px;
        top: 30px;
        background: transparent;
        color: white;
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 5px;
        font-size: 20px;
        padding: 5px 12px;
        cursor: pointer;
       
       }

     .box {
        border:2px solid green;
        border-radius:10px;
        margin :30px;
        display: grid;
        padding:10px;
        bottom:100px;
        transition: transform 1.0s;
       box-shadow: 5px 5px 5px 5px hwb(120 2% 70%);
      }
      .box:hover{
        transform: scale(1.03);
      }
      #LINK{
        font-weight: bold;
        font-size: 15px;
        text-align: center;
        color:hwb(195 0% 36%);
      }
      #login{
        background-color:hwb(128 0% 47%);
        color:white;
        text-align: center;
        height: 40px;
        border-radius:7px;
        transition: transform 0.5s;
        transition: background-color 2s
      }
      #login:hover{
        transform: scale(1.02);
        background-color: hwb(120 2% 70%);
      }
      #p{
        color:hwb(0 11% 0%);
        font-size :10px;
        text-align:center;
      }
      #input{
        border-radius:30px;
        height: 30px;
        
      }
      #label{
        font-size:15px;
      }
      .box img{
        width: 70px;
        height: auto;
        justify-self: center;
        border: 3px solid green;
        border-radius:100px;
      }
      #footer {
        background-color: #343a40;
        color: white;
        text-align: center;
        padding: 20px;
        margin-top:30px;
        font-size:12px;
        height:2px;
      }
      #uni{
        color:hwb(197 3% 44%);
        font-weight: bold;
      }
      #c{
        font-weight: bold;
      }
    </style>
  </head>
  <body>
    <div class="head">
  <button class="menu">  ☰ </button>

      <p style="font-weight: bold;">HARAMAYA UNIVERSITY</p>
      <P style="font-size:11px;">OFFICE OF THE REGISTRAR</P>
    </div>
    <br> <br> <br> <br> <br>
    <div class="box">
      <img 
        src="IMG_20261007_133539_926.jpg"> 
      <br>
      <a ID="LINK" href="#">LOGIN TO SECURE ACCESS</a>
      <br> 
      <label id="label">username</label>
      <br>
      <input id="input"
        type="text" 
        placeholder="username">
      <br> 
      <label id="label">password</label>
      <br>
      <input id="input"
        type="password"
        placeholder="password">
      <br> 
      <button id="login">login</button>
      <p id="p">⚠️ update your password at least once every six months to avoid account blocking </p>
    </div>
    <br> <br> <br> <br> <br>
    <footer id="footer">
  <spam id="c">Copyright © 2026</spam> <spam id="uni">Haramaya University</spam>. All rights reserved.
    </footer>
  </body>
</html>
